# --- address ---------------------------------------------------------------------------------
# Your VPS public IP with dashes + .sslip.io (no signup), or your own domain.
SITE_ADDRESS=203-0-113-7.sslip.io
# The VPS public IPv4 (coturn advertises it to browsers).
PUBLIC_IP=203.0.113.7
# Optional: Let's Encrypt expiry notices.
ACME_EMAIL=
# Bare-IP HTTPS instead of sslip.io: set SITE_ADDRESS to the IP and uncomment.
# CADDYFILE=Caddyfile.ip

# --- secrets (generate each with: openssl rand -hex 32) ---------------------------------------
SESSION_SECRET=change-me
TURN_SECRET=change-me
# argon2 hash of the host password. Generate with:
#   docker compose run --rm api python -m app.hashpw
# and paste the printed line here (keep the single quotes).
ADMIN_PASSWORD_HASH='paste-the-hash-here'

# --- limits -----------------------------------------------------------------------------------
# Largest single upload, in bytes (default 60 GB).
MAX_UPLOAD_BYTES=60000000000

# Local development only: a plain-text host password instead of the hash.
# DEV_ADMIN_PASSWORD=localtest123
