# Alternative: HTTPS on the bare IP address, no third-party DNS at all.
# Let's Encrypt IP certificates (GA since Jan 2026) last ~6 days; Caddy renews them itself.
# Set SITE_ADDRESS to the public IP and CADDYFILE=Caddyfile.ip in .env.
{
	servers {
		# no HTTP/3: on the Indian mobile and home links we watch from, QUIC transfers stalled
		# for 30 s at a time (Caddy: "no recent network activity") while TCP kept working
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	import /etc/msync/site.caddy
}

