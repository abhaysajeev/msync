# SITE_ADDRESS is a hostname, e.g. 203-0-113-7.sslip.io (no account needed; sslip.io resolves it
# to that IP) or your own domain. Caddy gets and renews the Let's Encrypt certificate itself.
{
	servers {
		# no HTTP/3: on the Indian mobile and home links we watch from, QUIC transfers stalled
		# for 30 s at a time (Caddy: "no recent network activity") while TCP kept working
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	import /etc/msync/site.caddy
}
